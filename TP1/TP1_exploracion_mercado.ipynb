    "import config\n",
    "\n",
    "DB_PATH = Path(config.BASE_DIR) / 'data' / 'hotel_data.db'\n",
    "OUTPUT_DIR = Path(config.BASE_DIR) / 'TP1' / 'outputs'\n",
